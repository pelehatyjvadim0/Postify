# Docker Compose. Скопируйте в локальный .env; не коммитьте ключи.
AUTOPOST_PORT=8000
AUTOPOST_BIND=127.0.0.1
POSTIFY_TRUSTED_HOSTS=
CONTENT_ANALYZER=codex
CONTENT_MODEL=gpt-5.6-terra
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Провайдер подписей к изображениям и эмбеддингов: auto | mock | openrouter.
# auto = openrouter при заданном OPENROUTER_API_KEY, иначе mock (ненастоящие подписи и векторы).
AI_MEDIA_PROVIDER=auto

# Вход в приложение — через Telegram-бота авторизации.
# Без AUTH_BOT_TOKEN приложение не поднимется: войти будет нечем.
AUTH_BOT_TOKEN=
AUTH_BOT_USERNAME=
# Список telegram_user_id через запятую; пусто — вход открыт для всех.
AUTH_ALLOWED_TELEGRAM_IDS=

# Для Python вне Docker дополнительно нужны:
# DATABASE_URL=postgresql+psycopg://autopost:change_me@localhost:5432/autoposttg
# CONTENT_MEDIA_DIR=/absolute/path/to/media
# POSTIFY_SECRET_KEY=your_fernet_key
