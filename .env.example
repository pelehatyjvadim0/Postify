# Docker Compose. Скопируйте в локальный .env; не коммитьте ключи.
AUTOPOST_PORT=8000
AUTOPOST_BIND=127.0.0.1
POSTIFY_ACCESS_PASSWORD=
POSTIFY_TRUSTED_HOSTS=
CONTENT_ANALYZER=codex
CONTENT_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Для Python вне Docker дополнительно нужны:
# DATABASE_URL=postgresql+psycopg://autopost:change_me@localhost:5432/autoposttg
# CONTENT_MEDIA_DIR=/absolute/path/to/media
# POSTIFY_SECRET_KEY=your_fernet_key
