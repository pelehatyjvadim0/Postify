# Необязательные настройки Docker Compose. Секреты храните в локальном .env.
AUTOPOST_PORT=8000
CONTENT_ANALYZER=codex
CONTENT_MODEL=gpt-5.6-terra
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
AUTH_BOT_TOKEN=
AUTH_BOT_USERNAME=
AUTH_ALLOWED_TELEGRAM_IDS=
