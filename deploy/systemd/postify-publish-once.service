[Unit]
Description=Postify one-shot Telegram publication
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@ENV_FILE@
ExecStart=@PYTHON@ -m postify.cli publish-once
TimeoutStartSec=15min
SyslogIdentifier=postify-publish
